  try { const t = localStorage.getItem("tulay-theme"); if (t) document.documentElement.dataset.theme = t; } catch(e) {}
})();
</script><script>
(() => {
  const KEY = "tulay-howto-checks";
  let saved = {}; try { saved = JSON.parse(localStorage.getItem(KEY) || "{}") || {}; } catch(e) {}
  document.querySelectorAll(".check input").forEach(cb => {
    cb.checked = !!saved[cb.id];
    cb.addEventListener("change", () => { saved[cb.id] = cb.checked; try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch(e) {} });
  });
  const r = document.getElementById("resetchk");
  if (r) r.onclick = () => { saved = {}; try { localStorage.removeItem(KEY); } catch(e) {} document.querySelectorAll(".check input").forEach(c => c.checked = false); };
})();
</script></body></html>
